app/**/.flutter-plugins-dependencies
app/**/ios/Pods/
app/**/ios/.symlinks/
app/**/ios/Flutter/Generated.xcconfig
app/**/ios/Flutter/flutter_export_environment.sh
app/**/android/.gradle/
app/**/android/local.properties
*.iml
.idea/

# macOS
.DS_Store

# Firmware backups (large binaries)
*.bin

# Build / upload scratch output
firmware/**/*_log.txt

